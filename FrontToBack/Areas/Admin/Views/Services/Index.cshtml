@model IEnumerable<Services>

<table class="table">
    <a asp-action="Create" class="btn btn-success">Create</a>
    <thead>
        <tr>
            <th scope="col">Images</th>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">Operations</th>
        </tr>
    </thead>
    <tbody>

        @foreach(var item in Model)
        {
            <tr>
                <td><img src="~/assets/img/@item.Images" widht="80px" height="80px"></td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit" class="btn btn-info">Edit</a>
                    <a asp-action="Detail" class="btn btn-primary">Details</a>
                    <form>
                        <button asp-action="Delete" class="btn btn-warning">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tr>
    </tbody>
</table>